# Zero-config demo database
EUAS_DB_PATH=./euas.db
# Production database override (takes precedence when PostgreSQL URL is provided)
# EUAS_DATABASE_URL=postgresql://euas:change-me@localhost:5432/euas
EUAS_HOST=127.0.0.1
EUAS_PORT=8000
EUAS_ENV=development
EUAS_VERSION=3.9.0
EUAS_SESSION_HOURS=12
EUAS_MAX_UPLOAD_MB=25
EUAS_ALLOWED_DOC_SUFFIXES=.pdf,.png,.jpg,.jpeg,.webp,.txt,.csv,.doc,.docx,.xls,.xlsx,.dwg,.dxf,.zip

# Host-header allow-list used by app.production. List hostnames/IPs only (no scheme
# or port). A leading *. is supported for subdomains; unrestricted * is rejected.
# Replace the local defaults with the real ingress/application hostnames before
# production deployment.
EUAS_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional proxy CIDRs whose forwarded client and transport-scheme headers may be
# trusted by EUAS. Uvicorn proxy rewriting is disabled in the production image so
# this application-level list remains the single trust boundary. Leave empty
# unless the reverse-proxy network boundary is understood.
EUAS_TRUSTED_PROXY_CIDRS=

# 0 disables in-process scheduling; use scripts/run_automation.py from cron/Task Scheduler for clustered production deployments.
EUAS_AUTOMATION_INTERVAL_MINUTES=0

# Optional durable workflow-event delivery. Leave blank to retain events locally without outbound calls.
EUAS_EVENT_WEBHOOK_URL=
EUAS_EVENT_WEBHOOK_SECRET=
EUAS_OUTBOX_MAX_ATTEMPTS=5
# Durable claim lease; must remain above the five-second webhook timeout.
EUAS_OUTBOX_LEASE_SECONDS=30